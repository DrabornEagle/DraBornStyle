{
  "name": "drabornstyle",
  "version": "0.4.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:termux": "EXPO_UNSTABLE_HEADLESS=1 EXPO_NO_DEPENDENCY_VALIDATION=0 EXPO_NO_NEW_ARCH_COMPAT_CHECK=0 node --dns-result-order=ipv4first node_modules/expo/bin/cli start --go --localhost --port 8081 --clear",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:ui:v04": "npm run export:web && node tests/ui-v04.cjs",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:web": "expo export --platform web --output-dir dist-web",
    "export:site": "node scripts/dkd-export-site.mjs",
    "check": "npm run typecheck && npm test && expo install --check"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.14",
    "@expo/vector-icons": "15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "2.98.0",
    "expo": "58.0.7",
    "expo-constants": "58.0.10",
    "expo-crypto": "58.0.6",
    "expo-document-picker": "58.0.4",
    "expo-file-system": "58.0.8",
    "expo-font": "58.0.7",
    "expo-haptics": "58.0.5",
    "expo-image-picker": "58.0.10",
    "expo-linear-gradient": "58.0.3",
    "expo-linking": "58.0.11",
    "expo-location": "58.0.13",
    "expo-notifications": "58.1.2",
    "expo-secure-store": "58.0.2",
    "expo-task-manager": "58.0.11",
    "leaflet": "1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.4",
    "react-native-maps": "1.29.0",
    "react-native-safe-area-context": "5.9.1",
    "react-native-url-polyfill": "3.0.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.21",
    "@types/react": "19.3.0",
    "playwright": "1.64.0",
    "prettier": "3.8.3",
    "supabase": "2.120.0",
    "typescript": "6.0.3"
  }
}
