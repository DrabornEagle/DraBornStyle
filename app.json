{
  "expo": {
    "name": "DraBornStyle",
    "slug": "drabornstyle",
    "version": "0.2.17",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.draborneagle.drabornstyle",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.draborneagle.drabornstyle"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "demoMode": true,
      "release": "v0.2.17-final",
      "roleSource": "dkd_user_role_access",
      "defaultPlatformFeeTl": 20
    }
  }
}
